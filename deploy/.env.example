# Copy to deploy/.env and change every value marked CHANGE.
SITE_ADDRESS=stitchsense.your-factory.example   # CHANGE: domain (automatic HTTPS) or "localhost"
DB_PASSWORD=CHANGE-to-a-long-random-string
SS_ADMIN_EMAIL=admin@your-factory.example       # CHANGE
SS_ADMIN_PASSWORD=CHANGE-at-least-12-characters
SS_ENV=production                 # use "demo" for a demo install (creates demo logins)
SS_COOKIE_SECURE=true
# Demo installs only (university / sales demos): runs the factory simulator and shows demo logins.
SS_SIMULATOR_ENABLED=false        # demo installs: true
DEMO_MODE=0                       # demo installs: 1 (shows demo logins on the login page)
