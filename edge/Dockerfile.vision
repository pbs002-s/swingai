# Edge vision: OpenCV + ONNX Runtime (CPU) + MediaPipe. For an NVIDIA GPU, swap onnxruntime for
# onnxruntime-gpu on a CUDA base image; the code picks CUDAExecutionProvider when it is available.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.13 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --extra vision
COPY collector ./collector
COPY vision ./vision
RUN useradd --uid 10001 --no-create-home edge && mkdir -p /data && chown edge /data
USER edge
ENTRYPOINT ["uv", "run", "--no-sync", "python", "-m", "vision.pipeline"]
CMD ["--config", "/config/camera.json", "--source", "rtsp://camera/stream"]
